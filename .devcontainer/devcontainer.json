{
  "name": "Queryback · Hoja de Protección",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend & Build",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite Dashboard Dev",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r .hackathon/requirements.txt && npm --prefix dashboard ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
